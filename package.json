{
  "name": "@dsh-external/dsh-input-history",
  "version": "0.1.33",
  "private": true,
  "type": "module",
  "description": "DSH Web 输入历史插件：Ctrl+Up / Ctrl+Down 像终端一样召回与切换已发送消息，零核心改动",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./invariant": "./lib/invariant.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src",
    "LICENSE",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-session-controller": "link:../test-lhh010/packages/api/session-controller",
    "@deepseek-ai/dsh-client-ui-chat": "link:../test-lhh010/packages/client/ui-chat",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../test-lhh010/packages/client/ui-conversation",
    "@deepseek-ai/dsh-invariants": "link:../test-lhh010/packages/runtime-diagnostics/invariants",
    "@deepseek-ai/cordis": "link:../test-lhh010/vendor/cordis",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/dsh-home-paths": "link:../.dsh/source/current/packages/util/home-paths",
    "@types/node": "^22.10.2",
    "@deepseek-ai/dsh-host-webserver": "link:../.dsh/source/current/packages/host/webserver"
  },
  "license": "BSD-3-Clause"
}
